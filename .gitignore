# Xcode
build/
DerivedData/
*.xcuserstate
*.xcuserdatad/
xcuserdata/
*.xccheckout
*.xcscmblueprint
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# Xcode project. The SHARED project file (project.pbxproj and
# project.xcworkspace/contents.xcworkspacedata) IS tracked, so the agent can
# manage build phases/settings directly and the project survives a fresh
# clone. Per-user state inside the bundle (xcuserdata) stays ignored by the
# generic rules above. There is no XcodeGen/project.yml — the .xcodeproj is
# the source of truth.


# Swift Package Manager
.build/
Packages/
Package.resolved
.swiftpm/

# IDEs
.idea/
.vscode/

# Generated by Scripts/build-app-icon.swift — see that file's header.
TextCleaner/AppIcon.icns

# Rendered from USAGE.md / USAGE.it.md (`pandoc … -o …`). The source
# Markdown is checked in; the PDFs are local artefacts the DMG script
# will pick up if present.
USAGE.pdf
USAGE.it.pdf

# Xcode "Distribute App" exports usually land here when the user picks
# a folder inside the repo. The exported .app bundles are large and
# rebuildable; never commit them.
TextCleaner/*/*.app
TextCleaner/**/Export*

# Built DMGs are distributed via GitHub Releases, not via git.
*.dmg
